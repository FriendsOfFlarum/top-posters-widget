{
    "name": "fof/top-posters-widget",
    "description": "Top Posters Widget",
    "keywords": [
        "flarum",
        "widget",
        "posters",
        "forum"
    ],
    "funding": [
        {
            "type": "website",
            "url": "https://opencollective.com/fof/donate"
        }
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "homepage": "https://friendsofflarum.org",
    "support": {
        "issues": "https://github.com/FriendsOfFlarum/top-posters-widget/issues",
        "source": "https://github.com/FriendsOfFlarum/top-posters-widget",
        "forum": "https://discuss.flarum.org/d/39067"
    },
    "replace": {
        "afrux/top-posters-widget": "*"
    },
    "require": {
        "flarum/core": "^2.0.0",
        "fof/forum-widgets-core": "^2.0.0"
    },
    "require-dev": {
        "flarum/testing": "^2.0",
        "flarum/phpstan": "^2.0.0"
    },
    "authors": [
        {
            "name": "FriendsOfFlarum",
            "homepage": "https://friendsofflarum.org"
        }
    ],
    "autoload": {
        "psr-4": {
            "FoF\\TopPosters\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FoF\\TopPosters\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-2.x": "2.x-dev"
        },
        "flarum-extension": {
            "title": "FoF Top Posters Widget",
            "category": "forum-widget",
            "icon": {
                "name": "fas fa-sort-numeric-down",
                "backgroundColor": "#e74c3c",
                "color": "#fff"
            }
        },
        "flarum-cli": {
            "modules": {
                "githubActions": true
            }
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
